# Copy to apps/api/.env for running the API natively (pnpm dev) against the
# Postgres from `docker compose -f docker-compose.dev.yml up db`.
# These are LOCAL-ONLY values. The production .env lives on the server and is never committed.
DATABASE_URL=postgres://weather:weather@localhost:55432/weather
PORT=8002
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Shared secret devices send as the `x-api-key` header (min 16 chars).
# Production uses a generated one: `openssl rand -hex 32`.
INGEST_API_KEY=local-dev-only-key-0123456789abcdef
LOG_LEVEL=info

# Assistant (chat). Off by default. For local work without a key use the scripted provider:
#   ASSISTANT_ENABLED=true
#   ASSISTANT_PROVIDER=fake        # refused when NODE_ENV=production
# The real provider needs GEMINI_API_KEY and ASSISTANT_MODEL; they live only in the server's .env.
# Checked on 21.11.2026 with a free-tier key: gemini-3.5-flash-lite answers in about 1 s and calls tools; gemini-3.5-flash
# takes about 12 s (it thinks); gemini-flash-latest did not answer within 45 s; gemini-2.5-* are closed to new users.
#   ASSISTANT_PROVIDER=gemini
#   ASSISTANT_MODEL=gemini-3.5-flash-lite
# Try it: pnpm --filter @weather/api assistant:smoke "Какая температура в аудитории?"
ASSISTANT_ENABLED=false
# ASSISTANT_PROVIDER=fake
# GEMINI_API_KEY=
# ASSISTANT_MODEL=
# Limits of the free Gemini key (gemini-3.5-flash-lite): 15 requests a minute, 500 a day. A question costs
# two or more requests (a tool call, then the answer), so the whole service takes about 6 questions a minute.
# For a visit with a crowd: ASSISTANT_RATE_PER_MIN=4, ASSISTANT_RATE_PER_HOUR=40, ASSISTANT_RATE_GLOBAL_PER_MIN=6.
# ASSISTANT_RATE_PER_MIN=10
# ASSISTANT_RATE_PER_HOUR=60
# ASSISTANT_RATE_GLOBAL_PER_MIN=20
# A second model takes over while the first is out of quota (each model has its own quota). Check its limits in AI Studio first.
# ASSISTANT_FALLBACK_MODEL=gemini-3.1-flash-lite
# Requests a day the key allows for the main model and for the second one; past it that model is not asked.
# ASSISTANT_DAILY_LIMIT=500
# ASSISTANT_FALLBACK_DAILY_LIMIT=
# Minutes an answer that does not depend on the readings (norms, sensors) is kept and repeated; 0 turns it off.
# ASSISTANT_CACHE_TTL_MIN=360
# ASSISTANT_MAX_OUTPUT_TOKENS=600
# The lessons of the auditorium, local time. Without them the events "start/end of a lesson" are not told. EVENTS_UTC_OFFSET_MIN: the local time against UTC, minutes (default 300, Tashkent).
# EVENTS_LESSON_STARTS=13:30
# EVENTS_LESSON_ENDS=17:50
# EVENTS_UTC_OFFSET_MIN=300
