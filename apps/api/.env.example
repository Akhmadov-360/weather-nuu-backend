# Copy to apps/api/.env for running the API natively (pnpm dev) against the
# Postgres from `docker compose -f docker-compose.dev.yml up db`.
# These are LOCAL-ONLY values. The production .env lives on the server and is never committed.
DATABASE_URL=postgres://weather:weather@localhost:55432/weather
PORT=8002
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Shared secret devices send as the `x-api-key` header (min 16 chars).
# Production uses a generated one: `openssl rand -hex 32`.
INGEST_API_KEY=local-dev-only-key-0123456789abcdef
LOG_LEVEL=info
