{
  "name": "weather-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @weather/api db:generate",
    "db:migrate": "pnpm --filter @weather/api db:migrate",
    "db:seed": "pnpm --filter @weather/api db:seed",
    "sim": "pnpm --filter @weather/api sim",
    "stack:up": "docker compose -f docker-compose.dev.yml up --build",
    "stack:live": "docker compose -f docker-compose.dev.yml --profile live up --build",
    "stack:down": "docker compose -f docker-compose.dev.yml down",
    "stack:reset": "docker compose -f docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
